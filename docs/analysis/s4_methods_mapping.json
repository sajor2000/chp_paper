  "concepts": {
    "capture_rate": {
      "definition": "Capture rate is the proportion of a census tract's adult population seen at participating health systems in a given year and is the primary data coverage measure for reliability tier assignment.",
      "source": "ChicagoHealthMap data glossary"
    },
    "capture_rate_metric": {
      "definition": "Capture Rate is health-system patients divided by ACS census tract adult population; tracts with fewer than 30 health-system patients are excluded from analysis.",
      "source": "ChicagoHealthMap data glossary"
    },
    "geography": {
      "definition": "Census tract is the primary geographic unit used in Chicago Health Map.",
      "source": "ChicagoHealthMap data glossary"
    },
    "small_cell_suppression": {
      "definition": "Counts fewer than 10 people are hidden for privacy; suppressed values display as N/A or <10, not zero.",
      "source": "ChicagoHealthMap data glossary"
    },
    "standardized_mean_difference": {
      "definition": "An absolute standardized mean difference of 0.1 or greater flags meaningful demographic imbalance and is computed separately for age, sex, and race/ethnicity.",
      "source": "ChicagoHealthMap data glossary"
    }
  },
